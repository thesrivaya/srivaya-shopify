{% doc %}
  Premium About Us page for Srivaya — mauve brand palette, homepage typography, soft surfaces.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .sv-about-{{ ai_gen_id }} {
    --sv-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --sv-ink: #20181a;
    --sv-body: #61474d;
    --sv-accent: #6f4b53;
    --sv-accent-deep: #513c40;
    --sv-soft: #f6f1f2;
    --sv-pale: #ece4e6;
    --sv-white: #ffffff;
    display: block;
    width: 100%;
    color: var(--sv-body);
    background: var(--sv-white);
  }

  .sv-about-{{ ai_gen_id }} .sv-reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.75s var(--sv-ease), transform 0.75s var(--sv-ease);
  }

  .sv-about-{{ ai_gen_id }} .sv-reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .sv-about-{{ ai_gen_id }} .sv-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-wrap {
      padding-left: 48px;
      padding-right: 48px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 18px;
    font-family: var(--font-body-family, sans-serif);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sv-accent);
  }

  .sv-about-{{ ai_gen_id }} .sv-eyebrow::before,
  .sv-about-{{ ai_gen_id }} .sv-eyebrow::after {
    content: '';
    width: 28px;
    height: 1px;
    background: color-mix(in srgb, var(--sv-accent) 45%, transparent);
  }

  .sv-about-{{ ai_gen_id }} .sv-title {
    margin: 0 0 20px;
    font-family: var(--font-heading-family, Georgia, 'Times New Roman', serif);
    font-style: var(--font-heading-style, normal);
    font-weight: 400;
    font-size: 32px;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--sv-ink);
    text-align: center;
    text-wrap: balance;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-title {
      font-size: 40px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-body {
    max-width: 720px;
    margin: 0 auto;
    font-family: var(--font-body-family, sans-serif);
    font-size: 16px;
    line-height: 1.75;
    color: var(--sv-body);
  }

  .sv-about-{{ ai_gen_id }} .sv-body p {
    margin: 0 0 16px;
  }

  .sv-about-{{ ai_gen_id }} .sv-body p:last-child {
    margin-bottom: 0;
  }

  .sv-about-{{ ai_gen_id }} .sv-intro {
    max-width: 640px;
    margin: 0 auto 28px;
    text-align: center;
    font-family: var(--font-body-family, sans-serif);
    font-size: 16px;
    line-height: 1.7;
    color: var(--sv-body);
  }

  /* Hero */
  .sv-about-{{ ai_gen_id }} .sv-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    text-align: center;
    padding: 70px 24px 55px;
    background:
      radial-gradient(ellipse 80% 70% at 50% 0%, color-mix(in srgb, var(--sv-soft) 88%, #fff) 0%, transparent 70%),
      linear-gradient(180deg, var(--sv-soft) 0%, var(--sv-white) 100%);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-hero {
      padding: 100px 48px 75px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
  }

  .sv-about-{{ ai_gen_id }} .sv-hero-title {
    margin: 0 0 16px;
    font-family: var(--font-heading-family, Georgia, 'Times New Roman', serif);
    font-weight: 400;
    font-size: 32px;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--sv-ink);
    text-wrap: balance;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-hero-title {
      font-size: 40px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-hero-text {
    margin: 0 auto;
    max-width: 560px;
    font-size: 16px;
    line-height: 1.75;
    color: var(--sv-body);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-hero-text {
      font-size: 18px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-hero-rule {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 28px auto 0;
    color: var(--sv-accent);
  }

  .sv-about-{{ ai_gen_id }} .sv-hero-rule span {
    width: 40px;
    height: 1px;
    background: color-mix(in srgb, var(--sv-accent) 35%, transparent);
  }

  .sv-about-{{ ai_gen_id }} .sv-hero-rule svg {
    width: 10px;
    height: 10px;
    opacity: 0.7;
  }

  /* Story / Mission */
  .sv-about-{{ ai_gen_id }} .sv-section {
    padding: 60px 0;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-section {
      padding: 80px 0;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-section--soft {
    background: linear-gradient(180deg, var(--sv-white) 0%, var(--sv-soft) 40%, var(--sv-soft) 100%);
  }

  .sv-about-{{ ai_gen_id }} .sv-section--blush {
    background:
      radial-gradient(ellipse 70% 60% at 50% 0%, color-mix(in srgb, var(--sv-soft) 90%, #fff), transparent 70%),
      linear-gradient(180deg, var(--sv-white) 0%, var(--sv-soft) 55%, var(--sv-white) 100%);
  }

  /* Pills */
  .sv-about-{{ ai_gen_id }} .sv-pills {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    max-width: 900px;
    margin: 0 auto;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-pills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  @media screen and (min-width: 990px) {
    .sv-about-{{ ai_gen_id }} .sv-pills {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 64px;
    padding: 16px 18px;
    background: var(--sv-white);
    border: none;
    border-radius: 14px;
    box-shadow: 0 10px 28px rgba(49, 36, 38, 0.05);
    text-align: center;
    font-family: var(--font-body-family, sans-serif);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--sv-ink);
  }

  .sv-about-{{ ai_gen_id }} .sv-pill svg {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    color: var(--sv-accent);
  }

  /* Why cards */
  .sv-about-{{ ai_gen_id }} .sv-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    max-width: 1000px;
    margin: 0 auto;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media screen and (min-width: 990px) {
    .sv-about-{{ ai_gen_id }} .sv-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-card {
    background: var(--sv-white);
    border: none;
    border-radius: 18px;
    padding: 28px 24px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(49, 36, 38, 0.05);
    transition: transform 0.45s var(--sv-ease), box-shadow 0.45s var(--sv-ease);
  }

  @media (hover: hover) {
    .sv-about-{{ ai_gen_id }} .sv-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 18px 40px rgba(49, 36, 38, 0.08);
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-card-icon {
    width: 52px;
    height: 52px;
    margin: 0 auto 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--sv-soft);
    color: var(--sv-accent);
  }

  .sv-about-{{ ai_gen_id }} .sv-card-icon svg {
    width: 22px;
    height: 22px;
  }

  .sv-about-{{ ai_gen_id }} .sv-card-title {
    margin: 0 0 8px;
    font-family: var(--font-heading-family, Georgia, 'Times New Roman', serif);
    font-weight: 400;
    font-size: 18px;
    letter-spacing: -0.015em;
    color: var(--sv-ink);
  }

  .sv-about-{{ ai_gen_id }} .sv-card-text {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--sv-body);
  }

  /* Mission */
  .sv-about-{{ ai_gen_id }} .sv-mission-quote {
    max-width: 760px;
    margin: 0 auto 24px;
    padding: 0 0 0 20px;
    border-left: 2px solid color-mix(in srgb, var(--sv-accent) 55%, transparent);
    font-family: var(--font-heading-family, Georgia, 'Times New Roman', serif);
    font-weight: 400;
    font-size: 24px;
    font-style: italic;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--sv-ink);
    text-wrap: balance;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-mission-quote {
      font-size: 28px;
      padding-left: 24px;
    }
  }

  /* Founder */
  .sv-about-{{ ai_gen_id }} .sv-founder {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
    padding: 36px 28px 32px;
    background: var(--sv-white);
    border: none;
    border-radius: 18px;
    box-shadow: 0 16px 48px rgba(49, 36, 38, 0.07);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-founder {
      padding: 44px 40px 36px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-founder-mark {
    position: absolute;
    top: 18px;
    left: 24px;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 72px;
    line-height: 1;
    color: var(--sv-accent);
    opacity: 0.18;
    pointer-events: none;
  }

  .sv-about-{{ ai_gen_id }} .sv-founder-quote {
    position: relative;
    z-index: 1;
    margin: 0 0 18px;
    font-family: var(--font-body-family, sans-serif);
    font-size: 16px;
    font-style: italic;
    line-height: 1.75;
    color: var(--sv-body);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-founder-quote {
      font-size: 17px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-founder-attr {
    margin: 0;
    text-align: right;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--sv-accent);
  }

  /* Stats */
  .sv-about-{{ ai_gen_id }} .sv-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    max-width: 960px;
    margin: 8px auto 0;
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-stat {
    text-align: center;
    padding: 24px 12px;
    background: var(--sv-white);
    border-radius: 16px;
    box-shadow: 0 10px 28px rgba(49, 36, 38, 0.05);
  }

  .sv-about-{{ ai_gen_id }} .sv-stat-number {
    margin: 0 0 8px;
    font-family: var(--font-heading-family, Georgia, 'Times New Roman', serif);
    font-weight: 400;
    font-size: 32px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--sv-ink);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-stat-number {
      font-size: 36px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-stat-label {
    margin: 0;
    font-size: 14px;
    line-height: 1.4;
    color: var(--sv-body);
  }

  /* Social */
  .sv-about-{{ ai_gen_id }} .sv-socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
  }

  .sv-about-{{ ai_gen_id }} .sv-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 12px 20px;
    background: var(--sv-white);
    border: none;
    border-radius: 999px;
    box-shadow: 0 8px 20px rgba(49, 36, 38, 0.06);
    text-decoration: none;
    color: var(--sv-ink);
    font-size: 14px;
    font-weight: 500;
    transition: transform 0.35s var(--sv-ease), box-shadow 0.35s var(--sv-ease), color 0.35s var(--sv-ease);
  }

  .sv-about-{{ ai_gen_id }} .sv-social svg {
    width: 16px;
    height: 16px;
    color: var(--sv-accent);
  }

  @media (hover: hover) {
    .sv-about-{{ ai_gen_id }} .sv-social:hover {
      transform: translateY(-2px);
      color: var(--sv-accent-deep);
      box-shadow: 0 12px 26px rgba(49, 36, 38, 0.09);
    }
  }

  /* CTA */
  .sv-about-{{ ai_gen_id }} .sv-cta {
    text-align: center;
    padding: 70px 24px;
    background: linear-gradient(180deg, var(--sv-white) 0%, var(--sv-soft) 45%, var(--sv-soft) 100%);
  }

  @media screen and (min-width: 750px) {
    .sv-about-{{ ai_gen_id }} .sv-cta {
      padding: 90px 48px;
    }
  }

  .sv-about-{{ ai_gen_id }} .sv-cta-text {
    max-width: 520px;
    margin: 0 auto 28px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--sv-body);
  }

  .sv-about-{{ ai_gen_id }} .sv-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    min-width: 200px;
    padding: 16px 28px;
    background: {{ block.settings.cta_button_bg | default: '#6f4b53' }};
    color: {{ block.settings.cta_button_text | default: '#ffffff' }};
    border: 1px solid rgba(43, 43, 43, 0.35);
    border-radius: 6px;
    text-decoration: none;
    font-family: var(--font-body-family, sans-serif);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  @media (hover: hover) {
    .sv-about-{{ ai_gen_id }} .sv-cta-btn:hover {
      background: {{ block.settings.cta_button_hover | default: '#513c40' }};
      border-color: #312426;
    }
  }
{% endstyle %}

<about-srivaya-{{ ai_gen_id }} class="sv-about-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <section class="sv-hero">
    <div class="sv-hero-inner sv-reveal" data-sv-reveal>
      <p class="sv-eyebrow">{{ block.settings.hero_eyebrow | default: 'About Us' }}</p>
      <h1 class="sv-hero-title">{{ block.settings.hero_title | default: 'Crafted with Love, Worn with Pride.' }}</h1>
      <p class="sv-hero-text">{{ block.settings.hero_text | default: 'At Srivaya, we believe every woman deserves to shine — every single day.' }}</p>
      <div class="sv-hero-rule" aria-hidden="true">
        <span></span>
        <svg viewBox="0 0 12 12" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M6 0.8 7.2 4.8 11.2 6 7.2 7.2 6 11.2 4.8 7.2 0.8 6 4.8 4.8Z"/></svg>
        <span></span>
      </div>
    </div>
  </section>

  <section class="sv-section">
    <div class="sv-wrap sv-reveal" data-sv-reveal>
      <h2 class="sv-title">{{ block.settings.story_title | default: 'Our Story' }}</h2>
      <div class="sv-body">
        {% if block.settings.story_body != blank %}
          {{ block.settings.story_body }}
        {% else %}
          <p>It all started with a simple question — why should stunning jewellery always come with a stunning price tag? Srivaya was born in the heart of India, founded by people who deeply believe that every woman — regardless of her budget — deserves to feel beautiful, confident, and celebrated.</p>
          <p>We saw a gap in the market where quality AD Jewellery was either too expensive or too hard to find online. So we decided to change that. What began as a small passion project has grown into a brand trusted by thousands of happy customers across India.</p>
          <p>Every piece we curate is handpicked with love, care, and an eye for detail — because jewellery isn't just an accessory, it's an emotion.</p>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="sv-section sv-section--soft">
    <div class="sv-wrap sv-reveal" data-sv-reveal>
      <h2 class="sv-title">{{ block.settings.ad_title | default: 'What is AD Jewellery?' }}</h2>
      <p class="sv-intro">{{ block.settings.ad_intro | default: 'AD stands for American Diamond — a premium quality cubic zirconia stone that mirrors the brilliance and sparkle of a real diamond, at a fraction of the cost.' }}</p>
      <div class="sv-pills">
        <div class="sv-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3 14.5 9.5 21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Z"/></svg>
          {{ block.settings.pill_1 | default: 'Brilliant & Eye-Catching' }}
        </div>
        <div class="sv-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3v18M5 8l7-5 7 5M5 16l7 5 7-5"/></svg>
          {{ block.settings.pill_2 | default: 'Durable for Everyday Wear' }}
        </div>
        <div class="sv-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 8v8M9.5 10.5h3.2a1.8 1.8 0 0 1 0 3.6H9.5"/></svg>
          {{ block.settings.pill_3 | default: 'Affordable Elegance' }}
        </div>
        <div class="sv-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 8h12l-1 12H7L6 8Z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg>
          {{ block.settings.pill_4 | default: 'Perfect for Every Occasion' }}
        </div>
      </div>
    </div>
  </section>

  <section class="sv-section">
    <div class="sv-wrap sv-reveal" data-sv-reveal>
      <h2 class="sv-title">{{ block.settings.why_title | default: 'Why Choose Srivaya?' }}</h2>
      <div class="sv-cards">
        <div class="sv-card">
          <div class="sv-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3 14.5 9.5 21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Z"/></svg></div>
          <h3 class="sv-card-title">{{ block.settings.why_1_title | default: 'Premium Quality' }}</h3>
          <p class="sv-card-text">{{ block.settings.why_1_text | default: 'Every piece is carefully quality-checked before it reaches you.' }}</p>
        </div>
        <div class="sv-card">
          <div class="sv-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7"/><circle cx="7" cy="18" r="1.5"/><circle cx="17" cy="18" r="1.5"/></svg></div>
          <h3 class="sv-card-title">{{ block.settings.why_2_title | default: 'Pan India Delivery' }}</h3>
          <p class="sv-card-text">{{ block.settings.why_2_text | default: 'We deliver to every corner of India, quickly and safely.' }}</p>
        </div>
        <div class="sv-card">
          <div class="sv-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 8h16v11H4z"/><path d="M8 8V6a4 4 0 0 1 8 0v2"/></svg></div>
          <h3 class="sv-card-title">{{ block.settings.why_3_title | default: 'Packed with Love' }}</h3>
          <p class="sv-card-text">{{ block.settings.why_3_text | default: 'Your order arrives beautifully packaged, gift-ready.' }}</p>
        </div>
        <div class="sv-card">
          <div class="sv-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.6"/><path d="M4 4v4h4"/></svg></div>
          <h3 class="sv-card-title">{{ block.settings.why_4_title | default: 'Easy Returns' }}</h3>
          <p class="sv-card-text">{{ block.settings.why_4_text | default: 'Hassle-free return & exchange policy — no questions asked.' }}</p>
        </div>
        <div class="sv-card">
          <div class="sv-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3v18M8 8h5.5a2.5 2.5 0 0 1 0 5H8h6a2.5 2.5 0 0 1 0 5H8"/></svg></div>
          <h3 class="sv-card-title">{{ block.settings.why_5_title | default: 'Affordable Luxury' }}</h3>
