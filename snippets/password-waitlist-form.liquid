{% comment %}
  Password-page waitlist: name, email, mobile, WhatsApp.
  Name + email go to the customer record; mobile/WhatsApp are saved in customer notes
  (Shopify does not accept phone on the newsletter customer form).
{% endcomment %}

{% form 'customer', class: 'newsletter-form waitlist-form' %}
  <input type="hidden" name="contact[tags]" value="prospect, password page, waitlist">
  <input type="hidden" name="contact[note]" id="WaitlistNote--{{ section.id }}" value="">

  <div class="waitlist-form__fields">
    <div class="field">
      <input
        id="WaitlistName--{{ section.id }}"
        type="text"
        name="contact[first_name]"
        class="field__input"
        value="{% if form.first_name %}{{ form.first_name }}{% endif %}"
        autocomplete="name"
        required
        {% if form.errors %}
          aria-invalid="true"
        {% endif %}
        placeholder="{{ 'newsletter.waitlist.name' | t }}"
      >
      <label class="field__label" for="WaitlistName--{{ section.id }}">
        {{ 'newsletter.waitlist.name' | t }}
      </label>
    </div>

    <div class="field">
      <input
        id="WaitlistEmail--{{ section.id }}"
        type="email"
        name="contact[email]"
        class="field__input"
        value="{{ form.email }}"
        aria-required="true"
        autocorrect="off"
        autocapitalize="off"
        autocomplete="email"
        required
        {% if form.errors %}
          autofocus
          aria-invalid="true"
          aria-describedby="Waitlist-error--{{ section.id }}"
        {% elsif form.posted_successfully? %}
          aria-describedby="Waitlist-success--{{ section.id }}"
        {% endif %}
        placeholder="{{ 'newsletter.waitlist.email' | t }}"
      >
      <label class="field__label" for="WaitlistEmail--{{ section.id }}">
        {{ 'newsletter.waitlist.email' | t }}
      </label>
    </div>

    <div class="field">
      <input
        id="WaitlistMobile--{{ section.id }}"
        type="tel"
        class="field__input"
        inputmode="tel"
        autocomplete="tel"
        required
        placeholder="{{ 'newsletter.waitlist.mobile' | t }}"
        data-waitlist-mobile
      >
      <label class="field__label" for="WaitlistMobile--{{ section.id }}">
        {{ 'newsletter.waitlist.mobile' | t }}
      </label>
    </div>

    <div class="field">
      <input
        id="WaitlistWhatsapp--{{ section.id }}"
        type="tel"
        class="field__input"
        inputmode="tel"
        autocomplete="tel"
        required
        placeholder="{{ 'newsletter.waitlist.whatsapp' | t }}"
        data-waitlist-whatsapp
      >
      <label class="field__label" for="WaitlistWhatsapp--{{ section.id }}">
        {{ 'newsletter.waitlist.whatsapp' | t }}
      </label>
    </div>
  </div>

  {%- if form.errors -%}
    <small class="newsletter-form__message form__message" id="Waitlist-error--{{ section.id }}">
      <span class="svg-wrapper">
        {{- 'icon-error.svg' | inline_asset_content -}}
      </span>
      {{- form.errors.translated_fields.email | capitalize }}
      {{ form.errors.messages.email -}}
    </small>
  {%- endif -%}

  <button type="submit" class="waitlist-form__submit button button--full-width" name="commit">
    {{ 'newsletter.waitlist.button_label' | t }}
  </button>

  {%- if form.posted_successfully? -%}
    <h3
      class="newsletter-form__message newsletter-form__message--success form__message"
      id="Waitlist-success--{{ section.id }}"
      tabindex="-1"
      autofocus
    >
      <span class="svg-wrapper">
        {{- 'icon-success.svg' | inline_asset_content -}}
      </span>
      {{- 'newsletter.waitlist.success' | t }}
    </h3>
  {%- endif -%}
{% endform %}

<script>
  (function () {
    var emailInput = document.getElementById('WaitlistEmail--{{ section.id }}');
    if (!emailInput) return;
    var form = emailInput.closest('form');
    if (!form || form.dataset.waitlistBound === 'true') return;
    form.dataset.waitlistBound = 'true';

    var nameInput = document.getElementById('WaitlistName--{{ section.id }}');
    var mobileInput = document.getElementById('WaitlistMobile--{{ section.id }}');
    var whatsappInput = document.getElementById('WaitlistWhatsapp--{{ section.id }}');
    var noteInput = document.getElementById('WaitlistNote--{{ section.id }}');

    if (mobileInput && whatsappInput) {
      mobileInput.addEventListener('blur', function () {
        if (mobileInput.value.trim() && !whatsappInput.value.trim()) {
          whatsappInput.value = mobileInput.value.trim();
        }
      });
    }

    form.addEventListener('submit', function () {
      var name = nameInput ? nameInput.value.trim() : '';
      var mobile = mobileInput ? mobileInput.value.trim() : '';
      var whatsapp = whatsappInput ? whatsappInput.value.trim() : '';
      if (noteInput) {
        noteInput.value =
          'Waitlist signup' +
          '\nName: ' + name +
          '\nMobile: ' + mobile +
          '\nWhatsApp: ' + whatsapp;
      }
    });
  })();
</script>
